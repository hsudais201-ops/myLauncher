{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MFLegend",
  "version": "0.1.0",
  "identifier": "com.mflegend.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "MFLegend", "width": 1280, "height": 820, "minWidth": 720, "minHeight": 560, "center": true }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://launchermeta.mojang.com https://piston-meta.mojang.com https://piston-data.mojang.com; img-src 'self' asset: http://asset.localhost data: https:;" }
  },
  "bundle": { "active": true, "targets": ["deb", "appimage"] }
}
